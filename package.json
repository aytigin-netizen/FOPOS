{
  "name": "fopos",
  "version": "0.1.0",
  "private": true,
  "description": "Felsefe Öğretmeni Pedagojik İşletim Sistemi",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "curriculum:validate": "node --import tsx scripts/validate-curriculum.ts",
    "studio:validate": "node --import tsx scripts/validate-lesson-studio.ts",
    "daily-plan:validate": "node --import tsx scripts/validate-daily-plan.ts",
    "annual-plan:validate": "node --import tsx scripts/validate-annual-plan.ts",
    "department-minutes:validate": "node --import tsx scripts/validate-department-minutes.ts",
    "exam-generator:validate": "node --import tsx scripts/validate-exam-generator.ts",
    "exam-analysis:validate": "node --import tsx scripts/validate-exam-analysis.ts",
    "fopos-ai:validate": "node --import tsx scripts/validate-fopos-ai.ts",
    "privacy:validate": "node --import tsx scripts/validate-privacy.ts",
    "release:validate": "node --import tsx scripts/validate-release-readiness.ts",
    "document:validate": "node --import tsx scripts/validate-document-engine.ts",
    "e2e": "playwright test",
    "e2e:list": "playwright test --list",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "docx": "^9.7.1",
    "next": "^15.5.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  }
}
